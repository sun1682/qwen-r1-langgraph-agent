# Both models use the local Ollama OpenAI-compatible endpoint.
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL=qwen2.5:3b-q3_k_m

R1_BASE_URL=http://127.0.0.1:11434/v1
R1_API_KEY=ollama
R1_MODEL=deepseek-r1:7b-qwen-distill-q4_K_M

# Commands run with this directory as their working directory.
WORKSPACE_ROOT=.
# SQLite checkpoint DB and approved tool runs stay in this project.
CHECKPOINT_DB=./.agent/checkpoints.sqlite
APPROVAL_DB=./.agent/approvals.sqlite
MAX_TOOL_OUTPUT_CHARS=20000


